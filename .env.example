# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Session Configuration
SESSION_SECRET=a-secure-cryptographic-random-key-for-flask-sessions

# Security and Restrictions (Optional)
# If ALLOWED_GOOGLE_DOMAIN is set (e.g. example.com), only users with emails
# from that domain will be allowed to authenticate. If left blank, anyone can log in.
ALLOWED_GOOGLE_DOMAIN=

# URLs for Client-Server Interaction
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000
